# Copy this file to .env and update the values before starting the stack.

# Timezone
TZ=America/New_York

# Pi-hole (DNS ad blocker) — http://localhost:8081/admin
PIHOLE_PASSWORD=changeme123

# Grafana (dashboards) — http://localhost:3000
GF_SECURITY_ADMIN_PASSWORD=admin123

